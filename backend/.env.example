# Copiez ce fichier en `.env` puis renseignez les vraies valeurs.
# Ne committez jamais le fichier `.env`.

# --- Django ---
SECRET_KEY=changez-moi-avec-une-cle-aleatoire
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# origines autorisées pour le front (séparées par des virgules)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- PostgreSQL ---
DB_NAME=ecommerce_materiel_info
DB_USER=postgres
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# --- PayGate Global ---
PAYGATE_ID=
PAYGATE_SECRET=
PAYGATE_PAY_URL=https://paygateglobal.com/api/v1/pay
PAYGATE_STATUS_URL=https://paygateglobal.com/api/v2/status
PAYGATE_TIMEOUT=10
